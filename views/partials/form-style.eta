<style>
.page{flex-grow:1;display:flex;justify-content:center;padding:64px 80px 96px}
.card{width:100%;max-width:760px;box-sizing:border-box;display:flex;flex-direction:column;gap:22px;background:#FFFFFF;border:1px solid #D9D3C5;border-radius:14px;padding:36px}
.eyebrow{font-size:13px;font-weight:600;letter-spacing:1.6px;text-transform:uppercase;color:#52625A}
.page-title{margin:0;font-family:Fraunces,Georgia,serif;font-size:44px;line-height:1.08;font-weight:700;letter-spacing:-1px}
.lead{margin:0;font-size:18px;line-height:1.5;color:#3A4A40}
.section-label{margin:8px 0 0;font-size:13px;font-weight:600;letter-spacing:1.6px;text-transform:uppercase;color:#52625A}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.field{display:flex;flex-direction:column;gap:8px}
.field > label,.field > .label{font-size:14px;font-weight:600}
.field input[type=text],.field input[type=email],.field input[type=tel],.field input[type=date],.field select,.field textarea{height:52px;width:100%;box-sizing:border-box;border:1px solid #A9A293;border-radius:8px;padding:0 14px;font-size:16px;font-family:inherit;background:#FFFFFF;color:#1F2A24}
.field textarea{height:auto;min-height:130px;padding:12px 14px;line-height:1.5;resize:vertical}
.field input[type=file]{font-size:15px;font-family:inherit}
.field.has-error input,.field.has-error select,.field.has-error textarea{border-color:#A3300B}
.hint{font-size:14px;color:#4A5A50;font-weight:400}
.error{font-size:14px;color:#A3300B;font-weight:500}
.choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 16px}
.choices label,.radios label{display:flex;gap:10px;align-items:center;font-size:16px}
.radios{display:flex;gap:28px;flex-wrap:wrap}
input[type=checkbox],input[type=radio]{width:18px;height:18px;accent-color:#C4531A;margin:0}
.field > label.consent{font-weight:400;font-size:15px}
.consent{display:flex;gap:12px;align-items:flex-start;background:#F4F1EA;border-radius:10px;padding:16px 18px;font-size:15px;line-height:1.5}
.consent input{margin-top:3px;flex-shrink:0}
.btn{height:56px;background:#C4531A;color:#FFFFFF;border:0;border-radius:8px;font-size:17px;font-weight:600;font-family:inherit;cursor:pointer;padding:0 28px}
.btn:hover{background:#A94412}
.alert{background:#FBEDE6;border:1px solid #E7B9A1;border-radius:10px;padding:14px 18px;font-size:15px;line-height:1.5}
.hp{position:absolute!important;left:-10000px!important;width:1px;height:1px;overflow:hidden}
.prose{font-size:17px;line-height:1.6;color:#3A4A40}
.prose h2{font-family:Fraunces,Georgia,serif;font-size:26px;color:#1F2A24;margin:28px 0 8px}
@media (max-width: 900px){
 .page{padding:40px 16px 64px!important}
 .card{padding:24px 20px}
 .page-title{font-size:34px}
 .grid2,.choices{grid-template-columns:1fr}
}
</style>
