<form method="post" action="<%= it.action %>" class="inline">
<input type="hidden" name="_csrf" value="<%= it.csrf %>">
<select name="status" aria-label="Status">
<% it.statuses.forEach(function (s) { %><option value="<%= s %>"<%= s === it.current ? ' selected' : '' %>><%= s %></option><% }) %>
</select>
<button type="submit" class="secondary">Update</button>
</form>
