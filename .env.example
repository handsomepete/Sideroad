# Copy to .env (never commit it) and fill in. On the server: chmod 600 .env, owned by the sideroad user.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# On the shared server, listen on a Unix socket instead of a port (leave blank locally):
# SOCKET_PATH=/run/sideroad/sideroad.sock
# Public URL exactly as Twilio and browsers see it. Twilio signatures are checked against this.
PUBLIC_BASE_URL=http://localhost:3000
# Number of reverse proxies in front of the app: 1 behind Caddy/nginx/cloudflared, 0 when run directly.
# Only that many X-Forwarded-For hops are trusted, and only from a proxy on this machine.
TRUST_PROXY=0

DATABASE_URL=postgres://sideroad:sideroad@localhost:5432/sideroad
UPLOAD_DIR=./uploads

# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=
# Generate with: npm run hash-password  (keep the single quotes)
ADMIN_PASSWORD_HASH=

# Optional: leave all three blank to run without texting (the "text us" lines are hidden).
# Twilio console > Account info. Phone number in E.164, e.g. +15195550100
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: leave all three blank to run without email alerts.
# Any SMTP provider, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Sideroad <hello@example.com>"
# Where new request / trade signup alerts go
ADMIN_NOTIFY_EMAIL=
