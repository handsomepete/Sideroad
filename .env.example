# Copy to .env (never commit it) and fill in. On the server: chmod 600 .env, owned by the sideroad user.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Public URL exactly as Twilio and browsers see it. Twilio signatures are checked against this.
PUBLIC_BASE_URL=http://localhost:3000
# Set to true when running behind Caddy/nginx so client IPs are correct.
TRUST_PROXY=false

DATABASE_URL=postgres://sideroad:sideroad@localhost:5432/sideroad
UPLOAD_DIR=./uploads

# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=
# Generate with: npm run hash-password  (keep the single quotes)
ADMIN_PASSWORD_HASH=

# Twilio console > Account info. Phone number in E.164, e.g. +15195550100
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Any SMTP provider, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Sideroad <hello@example.com>"
# Where new request / trade signup alerts go
ADMIN_NOTIFY_EMAIL=
